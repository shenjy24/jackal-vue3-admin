ENV=prod
APP_NAME=jackal-vue3-admin

# 前端容器对外端口（宿主机端口 -> 容器 80）
APP_PORT=18080

# 前端容器内存限制
APP_MEMORY_LIMIT=512M
APP_MEMORY_RESERVATION=256M

# 运行时基础镜像（需提前 docker load 导入）
NGINX_IMAGE=nginx:1.30.2-alpine

# 上传的 dist 目录或压缩包所在目录，默认与 up.sh 同级。
DIST_DIR=.
# 可选：固定指定部署包；为空时自动查找 dist/ 或唯一 dist 压缩包。
# DIST_PACKAGE=jackal-vue3-admin-dist.tar.gz

# 保留的历史应用镜像数量
IMAGE_KEEP_COUNT=3
