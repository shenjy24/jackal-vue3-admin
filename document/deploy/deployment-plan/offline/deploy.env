# ============================================
# jackal-vue3-admin 内网部署环境配置
# 部署时 source 此文件作为默认值
# 生产环境请根据实际路径修改
# ============================================

# ----- 基础配置 -----
APP_NAME=jackal-vue3-admin
DEPLOY_USER=tech
DEPLOY_GROUP=tech

# ----- 目录配置 -----
PROJECT_HOME=/home/tech/workspace/jackal-vue3-admin
RELEASES_DIR=/home/tech/workspace/jackal-vue3-admin/releases
CURRENT_LINK="${RELEASES_DIR}/current"
BACKUP_DIR=/home/tech/workspace/jackal-vue3-admin/backup

# ----- Docker 构建镜像 -----
NODE_IMAGE=node:24.17.0-slim

# ----- Nginx 配置 -----
NGINX_CONF_DIR=/etc/nginx
NGINX_CONF_FILE=/etc/nginx/conf.d/jackal-vue3-admin.conf
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
# 如果使用 Nginx 默认站点方式，请取消下面注释
# NGINX_CONF_FILE=/etc/nginx/sites-enabled/jackal-vue3-admin

# ----- 部署行为 -----
# 构建后是否重启 Nginx，设为 0 则跳过
RESTART_NGINX=1
# 构建后是否保留最近的 N 个历史版本
KEEP_RELEASES=5
# 构建超时时间（秒）
BUILD_TIMEOUT=300
