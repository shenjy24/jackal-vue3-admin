# Image loading configuration used by load-images.sh.

# Directory relative to the deployment root, or use absolute paths in *_IMAGE_TAR.
IMAGE_DIR=images

# Node.js base image used by the build Dockerfile.
LOAD_NODE_IMAGE=1
NODE_IMAGE=node:24.17.0-slim
NODE_IMAGE_TAR=images/node-24.17.0-slim.tar

# Nginx base image used by the runtime Dockerfile.
LOAD_NGINX_IMAGE=1
NGINX_IMAGE=nginx:1.30.2-alpine
NGINX_IMAGE_TAR=images/nginx-1.30.2-alpine.tar
